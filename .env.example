# ─── Mosquitto / MQTT ──────────────────────────────────────
MQTT_HOST=172.17.0.1
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASSWORD=changeme

# ─── Home Assistant REST API (long-lived tokens) ──────────
# Generate: HA → Profile → Long-Lived Access Tokens → Create
HA_URL=http://localhost:8123
HA_TOKEN_G1=
HA_TOKEN_G2=
HA_TOKEN_G3=
HA_TOKEN_SUPERVISOR=

# ─── Local Calendar ICS path (per gateway) ────────────────
# Find via: ls /config/.storage/local_calendar/
HA_ICS_PATH_G1=/var/lib/homeassistant/homeassistant/.storage/local_calendar.g1.ics

# ─── LoRa serial ports (use /dev/serial/by-id/... for stability) ──
GATEWAY_MESH_PORT=/dev/ttyUSB1
SUPERVISOR_MESH_PORT_ANT1=/dev/ttyUSB0
SUPERVISOR_MESH_PORT_ANT2=/dev/ttyUSB1
SUPERVISOR_MESH_PORT_ANT3=/dev/ttyACM0

# ─── Launcher (web UI) ────────────────────────────────────
LAUNCHER_SSH_USER=td
LAUNCHER_SUDO_PASSWORD=changeme
